// SalesFlow - Prisma schema
//
// RULES THAT MUST NOT BE BROKEN (see docs/PHASES-PLAN.md):
//  - Money  : Decimal @db.Decimal(14, 2)  - never Float, never JS number
//  - Qty    : Decimal @db.Decimal(14, 3)
//  - Percent: Decimal @db.Decimal(5, 2)
//  - Timestamps are timestamptz (Prisma DateTime) and are stored in UTC
//  - Master data is soft deleted (deletedAt); financial/stock documents are
//    never updated or deleted after posting
//  - Every table has createdAt / updatedAt; documents also have createdBy
//
// Phase 0 ships the foundation only. Every later phase adds its own tables
// through a NEW migration; an applied migration is never edited.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  REP
  CUSTOMER
  STOREKEEPER
  ACCOUNTANT
}

enum AuditAction {
  // authentication
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  // generic entity operations
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  CANCEL
  // business specific
  CREDIT_OVERRIDE_GRANTED
  CREDIT_OVERRIDE_REJECTED
  STOCK_VOUCHER_POSTED
  STOCK_VOUCHER_ACKNOWLEDGED
  STOCK_COUNT_POSTED
  CASH_HANDOVER_CONFIRMED
  INVOICE_ISSUED
  CREDIT_NOTE_ISSUED
  PAYMENT_RECORDED
  RETURN_RECEIVED
  RATING_HIDDEN
  MESSAGE_SENT
  SETTINGS_UPDATED
  EXPORT
}

enum DocumentType {
  ORDER
  INVOICE
  CREDIT_NOTE
  STOCK_VOUCHER
  STOCK_COUNT
  PAYMENT
  CASH_HANDOVER
  RETURN_REQUEST
  VISIT
  CUSTOMER_CODE
  PRODUCT_CODE
  REP_CODE
}

// Phase 3: a customer pays cash on delivery or buys on account with a limit.
enum PaymentTerms {
  CASH
  CREDIT
}

// A blocked customer cannot place or have an approved order (Section 5.1).
enum CustomerStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

// E-invoice receiver classification (Section 5.1); the value is stored from
// Phase 3 because an invoice snapshot needs it, and used for submission only in
// Phase 12.
enum ReceiverType {
  BUSINESS
  PERSON
  FOREIGN
}

// Customer ledger entry kinds (Section 5.6). Phase 3 only ever writes OPENING;
// the rest are declared now so the enum does not change under an applied
// migration when Phase 6 starts posting invoices and payments.
enum LedgerEntryType {
  OPENING
  INVOICE
  PAYMENT
  CREDIT_NOTE
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Identity (Phase 1 owns the behaviour; Phase 0 owns the table)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  role               Role
  username           String?   @unique
  phone              String    @unique
  email              String?   @unique
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rep      Rep?
  customer Customer?

  auditLogs            AuditLog[]      @relation("AuditActor")
  sessions             UserSession[]
  loginAttempts        LoginAttempt[]
  passwordResets       PasswordReset[]
  issuedPasswordResets PasswordReset[] @relation("PasswordResetIssuer")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Sessions - the cookie only carries an opaque id; the truth lives here
// (decision D-007). A suspended account therefore loses access immediately,
// and admin revocation / logout leave a record.
// ---------------------------------------------------------------------------

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  csrfToken  String    @map("csrf_token")
  ip         String?
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ---------------------------------------------------------------------------
// Login attempts - append only, like audit_logs, so it carries `at` instead of
// created_at/updated_at. Backs the per-account and per-IP rate limits and the
// lockout counter (decision D-009).
// ---------------------------------------------------------------------------

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  userId     String?  @map("user_id") @db.Uuid
  ip         String?
  successful Boolean  @default(false)
  at         DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, at])
  @@index([ip, at])
  @@index([at])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------------
// Password resets - one row per admin reset, so the temporary password and its
// delivery are auditable and a used token can never be replayed.
// ---------------------------------------------------------------------------

model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  issuedById String?   @map("issued_by_id") @db.Uuid
  temporary  Boolean   @default(true)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("PasswordResetIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId, usedAt])
  @@map("password_resets")
}
// ---------------------------------------------------------------------------
// Company settings - singleton row (id = 1) enforced by the service layer
// ---------------------------------------------------------------------------

model CompanySettings {
  id                    Int     @id @default(1)
  legalName             String  @map("legal_name")
  taxRegistrationNumber String? @map("tax_registration_number")
  branchCode            String? @map("branch_code")
  activityCode          String? @map("activity_code")
  address               String?
  phone                 String?
  email                 String?
  logoPath              String? @map("logo_path")

  // Business defaults
  defaultVatRate            Decimal @default(14) @map("default_vat_rate") @db.Decimal(5, 2)
  invoicePrefix             String  @default("INV") @map("invoice_prefix")
  creditNotePrefix          String  @default("CN") @map("credit_note_prefix")
  orderPrefix               String  @default("ORD") @map("order_prefix")
  returnWindowDays          Int     @default(7) @map("return_window_days")
  blockOnOverdue            Boolean @default(true) @map("block_on_overdue")
  overdueGraceDays          Int     @default(3) @map("overdue_grace_days")
  geofenceRadiusM           Int     @default(200) @map("geofence_radius_m")
  geofenceBlock             Boolean @default(false) @map("geofence_block")
  defaultMaxDiscountPercent Decimal @default(10) @map("default_max_discount_percent") @db.Decimal(5, 2)
  whatsappEnabled           Boolean @default(false) @map("whatsapp_enabled")
  defaultCreditDays         Int     @default(30) @map("default_credit_days")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Audit log - append only, never updated or deleted
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  actorRole   Role?       @map("actor_role")
  action      AuditAction
  entityType  String      @map("entity_type")
  entityId    String      @map("entity_id")
  beforeJson  Json?       @map("before_json")
  afterJson   Json?       @map("after_json")
  metadata    Json?
  ip          String?
  userAgent   String?     @map("user_agent")
  at          DateTime    @default(now()) @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, at])
  @@index([at])
  @@index([action, at])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Gapless document numbering counters - locked with SELECT ... FOR UPDATE
// inside the same transaction that writes the document.
// ---------------------------------------------------------------------------

model DocumentCounter {
  id        String       @id @default(uuid()) @db.Uuid
  docType   DocumentType @map("doc_type")
  year      Int
  lastValue Int          @default(0) @map("last_value")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([docType, year], name: "document_counters_type_year_key")
  @@index([docType])
  @@map("document_counters")
}

// ---------------------------------------------------------------------------
// Forward references
// Declared in later phases. Prisma requires the models to exist for the
// relations above, so minimal shells are kept here and grow in place.
// ---------------------------------------------------------------------------

model Rep {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  code               String    @unique
  name               String
  phone              String
  maxDiscountPercent Decimal   @default(10) @map("max_discount_percent") @db.Decimal(5, 2)
  isActive           Boolean   @default(true) @map("is_active")
  hiredAt            DateTime? @map("hired_at") @db.Date
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments CustomerRepAssignment[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("reps")
}

model CustomerCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  nameEn    String?   @map("name_en")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customers Customer[]

  @@index([deletedAt])
  @@map("customer_categories")
}

// Section 5.1 customer master. Money columns are Decimal like everywhere else;
// the coordinates are Decimal(10,7) because the repo never uses floating point
// for a number a business depends on, even a position.
model Customer {
  id                    String         @id @default(uuid()) @db.Uuid
  // Nullable: a customer without a login account still exists as a master
  // record. One created by a rep always has an account (D-022).
  userId                String?        @unique @map("user_id") @db.Uuid
  code                  String         @unique
  name                  String
  tradeName             String?        @map("trade_name")
  contactPerson         String?        @map("contact_person")
  phone                 String?
  address               String?
  governorate           String?
  city                  String?
  lat                   Decimal?       @db.Decimal(10, 7)
  lng                   Decimal?       @db.Decimal(10, 7)
  categoryId            String?        @map("category_id") @db.Uuid
  priceListId           String?        @map("price_list_id") @db.Uuid
  paymentTerms          PaymentTerms   @default(CASH) @map("payment_terms")
  creditLimit           Decimal        @default(0) @map("credit_limit") @db.Decimal(14, 2)
  creditDays            Int            @default(0) @map("credit_days")
  status                CustomerStatus @default(ACTIVE)
  taxRegistrationNumber String?        @map("tax_registration_number")
  nationalId            String?        @map("national_id")
  receiverType          ReceiverType   @default(BUSINESS) @map("receiver_type")
  whatsappOptIn         Boolean        @default(false) @map("whatsapp_opt_in")
  notes                 String?
  deletedAt             DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  category      CustomerCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priceList     PriceList?                @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  assignments   CustomerRepAssignment[]
  ledgerEntries CustomerLedgerEntry[]

  // A customer is looked up by name, filtered by status and category, and a rep
  // list is scoped through the assignment table.
  @@index([deletedAt])
  @@index([status])
  @@index([categoryId])
  @@index([priceListId])
  @@index([name])
  @@map("customers")
}

// Section 5.1: exactly one current rep, with the full history kept so a
// reassignment never rewrites a document from before it (D-021). `openCustomerId`
// is a nullable unique alias of `customerId` that is set while the row is open
// and nulled when it closes: Postgres treats NULLs as distinct, so it permits any
// number of closed rows but only one open row per customer. It is the schema
// expressible equivalent of a partial unique index, which Prisma cannot declare.
model CustomerRepAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  repId          String    @map("rep_id") @db.Uuid
  openCustomerId String?   @unique @map("open_customer_id") @db.Uuid
  fromDate       DateTime  @map("from_date") @db.Date
  toDate         DateTime? @map("to_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rep      Rep      @relation(fields: [repId], references: [id], onDelete: Restrict)

  @@index([customerId, toDate])
  @@index([repId, toDate])
  @@map("customer_rep_assignments")
}

// Section 5.6 ledger, append only. Phase 3 writes the OPENING entry that carries
// a customer's opening balance (Section 13); the balance is derived from the sum
// of these rows, never stored as a source column (D-023). `referenceType` and
// `referenceId` stay null until Phase 6 posts invoice and payment entries.
model CustomerLedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  debit         Decimal         @default(0) @db.Decimal(14, 2)
  credit        Decimal         @default(0) @db.Decimal(14, 2)
  // Running balance after this row, computed under the same transaction that
  // writes it. The derived total is still the authority (D-023).
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(14, 2)
  referenceType String?         @map("reference_type")
  referenceId   String?         @map("reference_id") @db.Uuid
  notes         String?
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([entryType])
  @@map("customer_ledger_entries")
}

// ---------------------------------------------------------------------------
// Phase 2: catalog and pricing
//
// Prices are stored exclusive of VAT (Section 5.2) and the price list item is
// valid on a range of *dates*, not timestamps: the effective price is "the item
// valid on the order date", so a time component here would only introduce a way
// for the same day to resolve two different prices (decision D-018).
// ---------------------------------------------------------------------------

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  nameEn    String?   @map("name_en")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([deletedAt])
  @@map("product_categories")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  nameEn    String?   @map("name_en")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([deletedAt])
  @@map("units")
}

model Product {
  id         String    @id @default(uuid()) @db.Uuid
  code       String    @unique
  nameAr     String    @map("name_ar")
  nameEn     String?   @map("name_en")
  categoryId String    @map("category_id") @db.Uuid
  unitId     String    @map("unit_id") @db.Uuid
  // Optional: how many base units one pack contains.
  packSize   Decimal?  @map("pack_size") @db.Decimal(14, 3)
  vatRate    Decimal   @default(14) @map("vat_rate") @db.Decimal(5, 2)
  costPrice  Decimal?  @map("cost_price") @db.Decimal(14, 2)
  isActive   Boolean   @default(true) @map("is_active")
  // Path only. The upload and virus-scan hook points arrive with the file
  // handling phase; Phase 2 stores the reference and nothing else.
  imagePath  String?   @map("image_path")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // E-invoice readiness only (Section 11). Structure now, values in Phase 12.
  itemCodeType String? @map("item_code_type")
  itemCode     String? @map("item_code")
  etaUnitType  String? @map("eta_unit_type")

  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit       Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  priceItems PriceListItem[]

  @@index([categoryId])
  @@index([unitId])
  @@index([isActive, deletedAt])
  @@index([nameAr])
  @@map("products")
}

model PriceList {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  nameEn    String?   @map("name_en")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items     PriceListItem[]
  customers Customer[]

  @@index([deletedAt])
  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(uuid()) @db.Uuid
  priceListId String    @map("price_list_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  // Exclusive of VAT, per Section 5.2.
  price       Decimal   @db.Decimal(14, 2)
  validFrom   DateTime  @map("valid_from") @db.Date
  // null means "open ended".
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  // One row per product per start date. Overlapping windows are rejected by the
  // service (D-018) because a unique index cannot express "no overlap" and a
  // silent tie would pick a price nobody chose. `map` names the index in the
  // database; Prisma 6 ignores `name` here.
  @@unique([priceListId, productId, validFrom], map: "price_list_items_unique_start")
  // The resolver filters on these, so they are indexed as a pair.
  @@index([priceListId, productId])
  @@index([validFrom, validTo])
  @@map("price_list_items")
}
