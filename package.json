{
  "name": "salesflow",
  "version": "0.1.0",
  "private": true,
  "description": "Sales representatives and customers distribution system (Egypt)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "worker:prod": "node --import tsx src/worker/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:validate": "prisma validate",
    "db:format": "prisma format"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "argon2": "0.41.1",
    "decimal.js": "10.4.3",
    "dotenv": "16.4.7",
    "next": "15.5.26",
    "next-intl": "4.14.8",
    "pg-boss": "10.1.5",
    "pino": "9.6.0",
    "prisma": "6.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "pino-pretty": "13.0.0",
    "postcss": "8.5.28",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "allowScripts": {
    "@prisma/client@6.2.1": true,
    "@prisma/engines@6.2.1": true,
    "argon2@0.41.1": true,
    "prisma@6.2.1": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.12": true
  }
}
