# ---------------------------------------------------------------------------
# SalesFlow - environment variables
# Copy to `.env` and fill in. NEVER commit a real .env file.
# Values here are development-safe placeholders only.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public origin used to build absolute links (invoice PDF share links, emails)
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Local docker compose database
DATABASE_URL=postgresql://salesflow:salesflow@localhost:5432/salesflow?schema=public
# Separate database used by the integration test suite (tests wipe it)
TEST_DATABASE_URL=postgresql://salesflow:salesflow@localhost:5432/salesflow_test?schema=public

# --- Auth (Phase 1) --------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# Argon2id parameters (OWASP minimum recommended values)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Login throttling (Phase 1) -------------------------------------------
LOGIN_MAX_ATTEMPTS_PER_IP=10
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
LOGIN_LOCKOUT_MINUTES=15
# Length of the rolling window the limits count failures over
LOGIN_WINDOW_MINUTES=15

# --- Sessions (Phase 1) ----------------------------------------------------
# How long a session cookie stays valid, and the CSRF token that travels with it
SESSION_TTL_HOURS=12
CSRF_TTL_MINUTES=12
# Set to true ONLY when a reverse proxy sets x-forwarded-for, otherwise the
# client can spoof the ip recorded in the audit log
TRUSTED_PROXY=false

# --- Uploads (Phase 8) -----------------------------------------------------
# Directory OUTSIDE the web root for return photos and attachments
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=5

# --- Signed links (Phase 6) -----------------------------------------------
# Used to sign expiring PDF share links
SIGNED_LINK_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
SIGNED_LINK_TTL_HOURS=168

# --- WhatsApp (Phase 9) ----------------------------------------------------
WHATSAPP_ENABLED=false
# cloud | console  (console = development/test only, prints instead of sending)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_API_BASE_URL=

# --- E-invoice (Phase 12, structure only) ----------------------------------
# TODO(verify-with-official-docs) - never guess these, see docs/E-INVOICE.md
EINVOICE_ENABLED=false
EINVOICE_GATEWAY_URL=
EINVOICE_GATEWAY_TOKEN=

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
# Pretty logs in development, JSON in production
LOG_PRETTY=true

# --- Business defaults (seed only, real values live in company_settings) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=+201000000000
SEED_ADMIN_PASSWORD=ChangeMe!123
